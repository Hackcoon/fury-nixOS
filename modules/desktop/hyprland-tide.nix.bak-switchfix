# Hyprland + Tide Island — one desktop module for your NixOS config
#
# Enables Hyprland (SDDM gets a "Hyprland" session), the Tide Island dynamic
# island, and every utility your binds/scripts/ricing workflow needs.
#
# All config is 100% Lua (~/.config/hypr/hyprland.lua + binds.lua).
#
# Paths here are anchored to the FLAKE ROOT via the module-system convention:
# this file is imported from configuration.nix as ./modules/desktop/hyprland-tide.nix
# so ../../pkgs/tide-island/ = /etc/nixos/pkgs/tide-island/  (flake root).
{ config, pkgs, lib, ... }:

{
  # =========================================================================
  # 0) TIDE ISLAND MODULE — defines programs.tide-island.* (in-tree copy of
  #    ~/Projects/tide-island-nix/module.nix — keep them in sync if you hack)
  # =========================================================================
  imports = [
    ../../pkgs/tide-island/module.nix
  ];

  # =========================================================================
  # 1) HYPRLAND — the compositor (window manager)
  # =========================================================================
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;   # X11 apps (Steam, some games) keep working
  };

  # =========================================================================
  # 2) TIDE ISLAND — the dynamic island widget
  # =========================================================================
  programs.tide-island = {
    enable = true;
    withHelpers = true;         # brightnessctl, cava, imagemagick, NM, pywal
    withSystemdService = false; # island starts from hyprland.lua instead
    package = pkgs.callPackage ../../pkgs/tide-island/tide-island.nix { };
  };

  # =========================================================================
  # 3) EVERYTHING YOUR RICE NEEDS (ONE list only — NixOS rejects duplicate
  #    environment.systemPackages definitions in the same module)
  # =========================================================================
  environment.systemPackages = with pkgs; [
    # ---- Hyprland first-party ecosystem ----
    hyprsunset       # night light — Tide's control-center toggle drives this
    hyprpaper        # simple wallpaper (alternative to awww)
    hypridle         # idle daemon → auto-lock via hyprlock
    hyprlock         # lock screen (LockScreen.sh uses it)
    hyprpicker       # on-screen color picker
    hyprpolkitagent  # password prompts for privileged apps

    # ---- Wallpapers & bar ----
    awww             # swww fork (nixpkgs 26.05 renamed it) — Tide Island's
                     # wallpaper picker drives this natively, out of the box
    waybar           # status bar (WaybarStyle.sh / WaybarLayout.sh cycle it)
    wlogout          # logout menu (Wlogout.sh)

    # ---- Notifications ----
    swaynotificationcenter   # swaync + swaync-client (SUPER SHIFT+N toggles panel)
    libnotify                # notify-send (all your scripts use it)
    # NOTE: Tide Island renders its OWN popups. If you see doubled
    # notifications, stop autostarting one of the two (hyprland.lua autostarts
    # swaync; comment that line out to let Tide own notifications).

    # ---- Rofi stack ----
    rofi           # 2.0 — Wayland-native now, no rofi-wayland needed
    rofi-calc      # RofiCalc.sh  (modi: calc — qalculate backend)
    rofi-emoji     # Emoticon.sh  (modi: emoji)

    # ---- Screenshots ----
    grim           # capture (ScreenShot.sh)
    slurp          # region select
    satty          # annotation editor (SUPER SHIFT+S screenshot mode)
    # wl-clipboard + cliphist already in system-packages.nix — keep them there

    # ---- Audio / media / misc (used by scripts + binds) ----
    pamixer                # CLI volume control
    playerctl              # MPRIS media keys
    brightnessctl          # brightness (Tide + scripts)
    pavucontrol            # GUI mixer (KooLSettings.sh)
    mpv                    # RofiBeats.sh streams
    jq                     # JSON parsing (SwitchLayout.sh, Zoom.sh)
    wlr-randr              # display settings (KooLSettings.sh)
    networkmanagerapplet   # nm-applet tray (island also has wifi panel)
    python3                # URL-encoding in GoogleSearch.sh etc.
  ];

  # UPower powers Tide's battery tile; BlueZ for its Bluetooth page
  # (the imported tide-island module already defaults these on).
}

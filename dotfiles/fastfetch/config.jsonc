{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    // ── CUSTOM PHOTO ── change this path to ANY image you want ──
    "source": "/home/fury/Pictures/goated_4k.png",
    // "kitty" = crisp image in Kitty / Ghostty / WezTerm / Konsole
    // If your terminal shows nothing, change to "chafa" (works EVERYWHERE) or "sixel"
    "type": "kitty",
    "width": 32,
    "height": 16,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "preserveAspectRatio": true,
    "printRemaining": true,
    "recache": true,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": false,
    "hideCursor": true,
    "separator": " 󰁔 ",
    "color": {
      "keys": "white",
      "title": "magenta",
      "output": "white",
      "separator": "magenta"
    },
    "brightColor": true,
    "key": {
      // "both" = show Nerd Font ICON + label. This is what gives every line an icon.
      "type": "both",
      "width": 12,
      "paddingLeft": 0
    },
    "percent": {
      "type": ["bar", "num"],
      "ndigits": 0,
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "border": {
        "left": "",
        "right": "",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "white",
        "border": "white"
      },
      "width": 12
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 2
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true
  },
  "modules": [
    {
      "type": "title",
      "key": "",
      "keyIcon": "",
      "keyColor": "magenta",
      "format": "{user-name-colored}@{host-name-colored}",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "magenta"
    },
    {
      "type": "command",
      "key": "Rice",
      "keyIcon": "󰚩",
      "keyColor": "cyan",
      "text": ". /etc/os-release 2>/dev/null; distro=\"${NAME:-$(uname -s)}\"; id=\"${ID:-}\"; case \"$id\" in nixos) di=\"❄️\";; arch|manjaro|endeavouros|garuda|cachyos) di=\"\";; ubuntu|pop|pop!_os|mint|zorin|tuxedo) di=\"\";; debian|raspbian) di=\"\";; fedora|rhel|centos|almalinux|rocky) di=\"\";; opensuse*) di=\"\";; void) di=\"\";; gentoo) di=\"\";; alpine) di=\"\";; darwin) di=\"🍎\"; distro=\"$(sw_vers -productName 2>/dev/null || echo macOS)\";; *) di=\"🐧\";; esac; base=\"$di $distro\"; if pgrep -f \"[q]uickshell.*dms\" >/dev/null 2>&1 || pgrep -f \"[d]ms run\" >/dev/null 2>&1 || pgrep -x dms >/dev/null 2>&1; then ds=\" + 🍁 DMS\"; else ds=\"\"; fi; sess=\"$XDG_CURRENT_DESKTOP $XDG_SESSION_DESKTOP $DESKTOP_SESSION\"; s=$(printf '%s' \"$sess\" | tr '[:upper:]' '[:lower:]'); case \"$s\" in *mango*) echo \"$base + 🥭 mango$ds\";; *hypr*) echo \"$base + 🌀 hyprland$ds\";; *dwm*) echo \"$base + 🪟 dwm\";; *kde*|*plasma*) echo \"$base + 🖥️ KDE Plasma\";; *xfce*) echo \"$base + 🐭 Xfce\";; *niri*) echo \"$base + Niri\";; *sway*) echo \"$base + 🌊 Sway\";; *cosmic*) echo \"$base + 🚀 COSMIC\";; *gnome*) echo \"$base + 🦶 GNOME\";; *) if pgrep -x mango >/dev/null 2>&1; then echo \"$base + 🥭 mango$ds\"; elif pgrep -x Hyprland >/dev/null 2>&1 || [ -n \"$HYPRLAND_INSTANCE_SIGNATURE\" ]; then echo \"$base + 🌀 hyprland$ds\"; elif pgrep -x dwm >/dev/null 2>&1; then echo \"$base + 🪟 dwm\"; elif [ -n \"$XDG_CURRENT_DESKTOP\" ]; then echo \"$base + $XDG_CURRENT_DESKTOP\"; elif [ -n \"$XDG_SESSION_DESKTOP\" ]; then echo \"$base + $XDG_SESSION_DESKTOP\"; elif [ -n \"$DESKTOP_SESSION\" ]; then echo \"$base + $DESKTOP_SESSION\"; else echo \"$base\"; fi;; esac",
      "format": "{result}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "magenta"
    },
    {
      "type": "os",
      "key": "OS",
      "keyIcon": "",
      "keyColor": "blue"
    },
    {
      "type": "board",
      "key": "Board",
      "keyIcon": "󰌢",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyIcon": "",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyIcon": "",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyIcon": "󰏖",
      "keyColor": "magenta",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyIcon": "",
      "keyColor": "red"
    },
    {
      "type": "editor",
      "key": "Editor",
      "keyIcon": "󰈮",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "Display",
      "keyIcon": "󰍹",
      "keyColor": "cyan",
      "compactType": "original"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyIcon": "",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "Icons",
      "keyIcon": "",
      "keyColor": "green"
    },
    {
      "type": "font",
      "key": "Font",
      "keyIcon": "",
      "keyColor": "red"
    },
    {
      "type": "cursor",
      "key": "Cursor",
      "keyIcon": "󰆿",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyIcon": "",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyIcon": "",
      "keyColor": "red",
      "format": "{name} ({cores-physical}p/{cores-logical}t) @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyIcon": "󰾲",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyIcon": "",
      "keyColor": "yellow"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyIcon": "󰓡",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyIcon": "",
      "keyColor": "blue"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "keyIcon": "󰩟",
      "keyColor": "green"
    },
    {
      "type": "locale",
      "key": "Locale",
      "keyIcon": "",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "block",
      "paddingLeft": 2,
      "block": {
        "width": 4,
        "range": [0, 15]
      }
    }
  ]
}
